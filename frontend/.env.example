# Public API base URL, including /api. Never put secrets here.
# npm run dev reads .env.development; npm run build reads .env.production.
# Local value (use .env.development.local for personal overrides):
VITE_API_BASE_URL=http://localhost:5000/api
# Netlify production: VITE_API_BASE_URL=https://portofilo-5717.onrender.com/api
# VITE_API_URL remains supported for older deployments.
